{
  "name": "vedacao-api",
  "private": true,
  "type": "module",
  "version": "4.2.0",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src",
    "coverage:unit": "c8 --all --include=\"src/**/*.js\" --include=\"prisma/*.js\" --reports-dir=coverage/unit --reporter=text --reporter=json-summary --reporter=lcov --check-coverage --lines 75 node --experimental-test-module-mocks --test tests/*.test.js tests/unit/*.test.mjs",
    "coverage": "c8 --all --include=\"src/**/*.js\" --include=\"prisma/*.js\" --reporter=text --reporter=html --reporter=lcov --reporter=json-summary --check-coverage --lines 75 node tests/cobertura.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "c8": "^9.1.0",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "prisma": "6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
